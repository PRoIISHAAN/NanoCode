{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "files": {
    "includes": [
      "packages/*/src/**/*.ts",
      "packages/*/src/**/*.tsx",
      "packages/*/test/**/*.ts",
      "packages/*/test/**/*.tsx",
      "!**/node_modules",
      "!**/dist"
    ]
  }
}
